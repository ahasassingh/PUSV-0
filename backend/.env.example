# CIVIC-AI Environment Configuration Template
# Copy this file to .env and insert your secrets if using external APIs.

# AI Provider Settings ("mock" or "gemini")
AI_PROVIDER=mock

# Google Gemini API Key (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-1.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# Database & Vehicle defaults
DATABASE_URL=sqlite:///./civic_ai.db
REFERENCE_VEHICLE=PUSV-01
SW_VERSION=PUSV-SW-0.1
MAX_REQUIREMENT_UPLOAD_MB=10
